# Variáveis de ambiente usadas pela API. Defina no terminal antes de rodar localmente
# (ex.: PowerShell  $env:API_KEY="minha-chave") ou na aba Environment do Render.
# Sem DATABASE_URL a API usa SQLite local (lampada_iot.db).
DATABASE_URL=
API_KEY=troque-esta-chave
RETENCAO_DIAS=30
PONTE_INTERVALO_S=5
ARDUINO_DEVICE_ID=
ARDUINO_SECRET_KEY=
